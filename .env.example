ENVIRONMENT=development
LOG_LEVEL=INFO

# EMQX MQTT Configuration
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=your-username
MQTT_PASSWORD=device-token-from-backend
MQTT_CLIENT_ID=emqx_bridge_svc_01
MQTT_KEEPALIVE=60
MQTT_TOPIC=swd/+/#
MQTT_QOS=1
MQTT_SHARE_GROUP=bridge-workers

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=amq.topic
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_PUBLISH_MAX_RETRIES=3
RABBITMQ_PUBLISH_RETRY_DELAY=2.0
